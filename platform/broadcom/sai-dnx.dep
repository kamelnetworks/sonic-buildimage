#DPKG FRK
DNX_DEP_FILES := $(SONIC_COMMON_FILES_LIST) platform/broadcom/sai-dnx.mk platform/broadcom/sai-dnx.dep
DNX_DEP_FILES += $(SONIC_COMMON_BASE_FILES_LIST) scripts/remote_artifact_fingerprint.sh

# Include the remote artifact metadata because the package URL may be mutable.
# Only blob-identifying headers are hashed, see scripts/remote_artifact_fingerprint.sh.
DNX_SAI_FLAGS := $(shell scripts/remote_artifact_fingerprint.sh $($(BRCM_DNX_SAI)_URL))

$(BRCM_DNX_SAI)_CACHE_MODE := GIT_CONTENT_SHA
$(BRCM_DNX_SAI)_DEP_FLAGS  := $(SONIC_COMMON_FLAGS_LIST) $(DNX_SAI_FLAGS)
$(BRCM_DNX_SAI)_DEP_FILES  := $(DNX_DEP_FILES)
