Subject: Use standard HTTP trailer prefix for gRPC with Go 1.27

The pinned gRPC version uses a constant excluded from x/net/http2 by its
Go 1.27 build tags. net/http exports the identical constant. Apply the same
compatibility fix as the management framework during normal vendoring.

--- a/Makefile
+++ b/Makefile
@@ -122,6 +122,7 @@
 	chmod -R u+w vendor
 	patch -d vendor -p0 < patches/gnmi_path.patch
 	patch -d vendor -p0 < patches/gnmi_xpath.patch
+	patch -d vendor/google.golang.org/grpc -p1 < patches/grpc-http-trailers.patch
 
 	touch $@
 
--- /dev/null
+++ b/patches/grpc-http-trailers.patch
@@ -0,0 +1,11 @@
+--- a/internal/transport/handler_server.go
++++ b/internal/transport/handler_server.go
+@@ -268,7 +268,7 @@
+ 				for _, v := range vv {
+ 					// http2 ResponseWriter mechanism to send undeclared Trailers after
+ 					// the headers have possibly been written.
+-					h.Add(http2.TrailerPrefix+k, encodeMetadataHeader(k, v))
++					h.Add(http.TrailerPrefix+k, encodeMetadataHeader(k, v))
+ 				}
+ 			}
+ 		}
