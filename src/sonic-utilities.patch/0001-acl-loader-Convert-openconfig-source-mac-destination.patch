diff --git a/tests/acl_loader_test.py b/tests/acl_loader_test.py
index a68cb93c..b290861e 100644
--- a/tests/acl_loader_test.py
+++ b/tests/acl_loader_test.py
@@ -380,3 +380,114 @@ class TestMasicAclLoader(object):
         acl_loader.load_rules_from_file(os.path.join(test_path, 'acl_input/incremental_2.json'))
         acl_loader.incremental_update()
         assert acl_loader.rules_info[(('NTP_ACL', 'RULE_1'))]["PACKET_ACTION"] == "DROP"
+
+
+class TestAclLoaderL2(object):
+    """openconfig l2 source-mac/destination-mac (and masks) to SRC_MAC/DST_MAC"""
+
+    L2_TABLES = {
+        "L2ACL": {"type": "L2", "stage": "ingress", "policy_desc": "L2ACL", "ports": ["Ethernet0"]},
+        "L2ACL_CUSTOM": {"type": "SRCMACONLY", "stage": "ingress", "policy_desc": "L2ACL_CUSTOM",
+                         "ports": ["Ethernet0"]},
+    }
+    L2_TABLE_TYPES = {
+        "SRCMACONLY": {"ACTIONS": "PACKET_ACTION,COUNTER", "BIND_POINTS": "PORT",
+                       "MATCHES": "INNER_SRC_MAC,INNER_DST_MAC,SRC_MAC,ETHER_TYPE"},
+    }
+
+    @pytest.fixture(scope="class")
+    def acl_loader(self):
+        yield AclLoader()
+
+    @pytest.fixture
+    def l2_acl_loader(self, acl_loader):
+        acl_loader.rules_info = {}
+        with mock.patch.dict(acl_loader.tables_db_info, self.L2_TABLES), \
+                mock.patch.dict(acl_loader.tables_type_info, self.L2_TABLE_TYPES), \
+                mock.patch("acl_loader.main.error") as error:
+            acl_loader.load_rules_from_file(os.path.join(test_path, 'acl_input/acl_l2.json'))
+            yield acl_loader, [str(c.args[0]) for c in error.call_args_list]
+
+    def test_source_mac(self, l2_acl_loader):
+        acl_loader, _ = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL", "RULE_1")] == {
+            "SRC_MAC": "02:16:90:00:00:01",
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9999"
+        }
+
+    def test_source_mac_with_ethertype(self, l2_acl_loader):
+        # The rule from kamelnetworks/sonic-buildimage#175: it became ETHER_TYPE only
+        acl_loader, _ = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL", "RULE_2")] == {
+            "SRC_MAC": "02:16:90:00:00:01",
+            "ETHER_TYPE": 34997,
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9998"
+        }
+
+    def test_source_mac_mask(self, l2_acl_loader):
+        acl_loader, _ = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL", "RULE_3")] == {
+            "SRC_MAC": "00:00:00:00:00:00/00:00:00:00:00:00",
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9997"
+        }
+
+    def test_destination_mac_mask_with_vlan(self, l2_acl_loader):
+        acl_loader, _ = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL", "RULE_4")] == {
+            "DST_MAC": "02:16:90:00:00:00/ff:ff:ff:00:00:00",
+            "VLAN_ID": 902,
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9996"
+        }
+
+    def test_source_and_destination_mac(self, l2_acl_loader):
+        acl_loader, _ = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL", "RULE_5")] == {
+            "SRC_MAC": "52:54:00:9A:39:5C",
+            "DST_MAC": "02:00:00:17:30:01",
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9995"
+        }
+
+    def test_mask_without_mac_is_rejected(self, l2_acl_loader):
+        acl_loader, errors = l2_acl_loader
+        assert ("L2ACL", "RULE_6") not in acl_loader.rules_info
+        assert ("L2ACL", "RULE_7") not in acl_loader.rules_info
+        assert any("source-mac-mask given without source-mac; table L2ACL rule 6" in e for e in errors)
+        assert any("destination-mac-mask given without destination-mac; table L2ACL rule 7" in e for e in errors)
+
+    def test_no_default_deny_rule_in_l2_table(self, l2_acl_loader):
+        acl_loader, _ = l2_acl_loader
+        assert ("L2ACL", "DEFAULT_RULE") not in acl_loader.rules_info
+
+    def test_custom_table_type_with_src_mac(self, l2_acl_loader):
+        acl_loader, errors = l2_acl_loader
+        assert acl_loader.rules_info[("L2ACL_CUSTOM", "RULE_1")] == {
+            "SRC_MAC": "02:16:90:00:00:01",
+            "PACKET_ACTION": "FORWARD",
+            "PRIORITY": "9999"
+        }
+        # DST_MAC is not in the type's MATCHES (INNER_DST_MAC must not count)
+        assert ("L2ACL_CUSTOM", "RULE_2") not in acl_loader.rules_info
+        assert any("destination-mac (DST_MAC) is not supported in table L2ACL_CUSTOM" in e for e in errors)
+
+    def test_mac_in_l3_table_is_rejected(self, l2_acl_loader):
+        # sonic-acl.yang allows SRC_MAC/DST_MAC only in L2 tables: fail
+        # instead of installing the rule without the MAC match
+        acl_loader, errors = l2_acl_loader
+        assert ("DATAACL", "RULE_1") not in acl_loader.rules_info
+        assert any("source-mac (SRC_MAC) is not supported in table DATAACL of type L3" in e for e in errors)
+
+    def test_unconverted_l2_field_is_rejected(self, acl_loader):
+        # A set l2 leaf that convert_l2() does not convert fails the rule
+        acl_loader.rules_info = {}
+        with mock.patch.dict(acl_loader.tables_db_info, self.L2_TABLES), \
+                mock.patch.object(AclLoader, "l2_converted_fields", {"ethertype", "vlan_id"}), \
+                mock.patch("acl_loader.main.error") as error:
+            acl_loader.load_rules_from_file(os.path.join(test_path, 'acl_input/acl_l2.json'))
+            errors = [str(c.args[0]) for c in error.call_args_list]
+        assert not [key for key in acl_loader.rules_info if key[0] == "L2ACL"]
+        assert any("l2 field source-mac is not supported by acl-loader" in e for e in errors)
