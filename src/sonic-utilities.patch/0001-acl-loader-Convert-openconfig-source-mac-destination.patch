From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christian Svensson <blue@cmd.nu>
Date: Fri, 6 Nov 2026 06:29:52 +0000
Subject: [PATCH] [acl-loader] Convert openconfig source-mac/destination-mac to
 SRC_MAC/DST_MAC

acl-loader ignored the openconfig l2 source-mac, source-mac-mask,
destination-mac and destination-mac-mask leaves: convert_l2() only
converted ethertype and vlan-id. A rule such as "ethertype 0x88b5 and
source-mac 02:16:90:00:00:01, drop" was installed as ETHER_TYPE only,
so it matched (and dropped) far more than written, without any error.

Convert them to SRC_MAC/DST_MAC in the "<mac>" or "<mac>/<mask>"
format of the sonic-types mac-addr-and-mask type. sonic-acl.yang
allows SRC_MAC/DST_MAC only in tables of the built-in type L2; a
user defined table type supports them if they are in its MATCHES.
Fail the rule with an error, like other conversion errors, instead of
dropping a field when
  - the table cannot match on the MAC (e.g. an L3 table),
  - a mask is given without its MAC address, or
  - any l2 leaf is set that convert_l2() does not convert.

Carried as src/sonic-utilities.patch in kamelnetworks/sonic-buildimage
(issue #175) until it lands upstream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012hdRF8fXTVYxQsK544FtsM
---
 acl_loader/main.py          |  52 ++++++++++
 tests/acl_input/acl_l2.json | 186 ++++++++++++++++++++++++++++++++++++
 tests/acl_loader_test.py    | 111 +++++++++++++++++++++
 3 files changed, 349 insertions(+)
 create mode 100644 tests/acl_input/acl_l2.json

diff --git a/acl_loader/main.py b/acl_loader/main.py
index 5cfbca4a..d845909b 100644
--- a/acl_loader/main.py
+++ b/acl_loader/main.py
@@ -116,6 +116,10 @@ class AclLoader(object):
         "IP_L2TP": 115
     }
 
+    # openconfig l2 config leaves that convert_l2() converts
+    l2_converted_fields = {"ethertype", "vlan_id", "source_mac", "source_mac_mask",
+                           "destination_mac", "destination_mac_mask"}
+
     def __init__(self):
         self.yang_acl = None
         self.requested_session = None
@@ -596,8 +600,56 @@ class AclLoader(object):
 
         return action_count == len(action_props)
 
+    def acl_table_has_mac_match(self, tname, match):
+        """
+        Check if the ACL table can match on an outer MAC address (SRC_MAC or DST_MAC).
+        sonic-acl.yang allows SRC_MAC/DST_MAC only in tables of the built-in type L2.
+        A user defined ACL table type supports them if they are in its MATCHES.
+        :param tname: ACL table name
+        :param match: SRC_MAC or DST_MAC
+        :return: True if the table can match on the MAC address
+        """
+        table_type = self.tables_db_info[tname]["type"]
+        if table_type in self.tables_type_info:
+            matches = self.tables_type_info[table_type]["MATCHES"]
+            # A list, or a comma separated string ("INNER_SRC_MAC" must not match "SRC_MAC")
+            if isinstance(matches, str):
+                matches = matches.split(",")
+            return match in [m.strip() for m in matches]
+        return table_type.upper() == "L2"
+
+    def convert_mac(self, table_name, rule_idx, match, mac, mask):
+        """
+        Convert an openconfig MAC address and optional mask to the Config DB
+        "<mac>" or "<mac>/<mask>" format (sonic-types mac-addr-and-mask)
+        """
+        name = "source-mac" if match == "SRC_MAC" else "destination-mac"
+        if not mac:
+            raise AclLoaderException("%s-mask given without %s; table %s rule %s" %
+                                     (name, name, table_name, rule_idx))
+        if not self.acl_table_has_mac_match(table_name, match):
+            raise AclLoaderException("%s (%s) is not supported in table %s of type %s; rule %s" %
+                                     (name, match, table_name, self.tables_db_info[table_name]["type"], rule_idx))
+        return "%s/%s" % (mac, mask) if mask else str(mac)
+
     def convert_l2(self, table_name, rule_idx, rule):
         rule_props = {}
+        l2 = rule.l2.config
+
+        # Fail on an l2 leaf that is set but not converted below, instead of
+        # installing a wider rule without it.
+        for leaf in l2._pyangbind_elements:
+            if leaf not in self.l2_converted_fields and getattr(l2, leaf)._changed():
+                raise AclLoaderException("l2 field %s is not supported by acl-loader; table %s rule %s" %
+                                         (leaf.replace("_", "-"), table_name, rule_idx))
+
+        if l2.source_mac or l2.source_mac_mask:
+            rule_props["SRC_MAC"] = self.convert_mac(table_name, rule_idx, "SRC_MAC",
+                                                     l2.source_mac, l2.source_mac_mask)
+
+        if l2.destination_mac or l2.destination_mac_mask:
+            rule_props["DST_MAC"] = self.convert_mac(table_name, rule_idx, "DST_MAC",
+                                                     l2.destination_mac, l2.destination_mac_mask)
 
         if rule.l2.config.ethertype:
             if rule.l2.config.ethertype in self.ethertype_map:
