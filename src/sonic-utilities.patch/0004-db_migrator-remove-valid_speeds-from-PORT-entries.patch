diff --git a/tests/db_migrator_test.py b/tests/db_migrator_test.py
index c6c85cd4..81c19835 100644
--- a/tests/db_migrator_test.py
+++ b/tests/db_migrator_test.py
@@ -1149,3 +1149,35 @@ class TestIPinIPTunnelEcnModeMigrator(object):
         expected_state_db = SonicV2Connector(host='127.0.0.1')
         expected_state_db.connect(expected_state_db.STATE_DB)
         self.compare_keys(expected_state_db, dbmgtr.stateDB, 'STATE_DB')
+
+
+class TestPortValidSpeedsMigrator(object):
+    def setup_method(self):
+        self.version_info = mock.patch.object(device_info, 'get_sonic_version_info',
+                                              return_value={'asic_type': 'broadcom'})
+        self.version_info.start()
+        dbconnector.dedicated_dbs['CONFIG_DB'] = os.path.join(mock_db_path, 'config_db', 'port_valid_speeds_input')
+
+    def teardown_method(self):
+        dbconnector.dedicated_dbs['CONFIG_DB'] = None
+        self.version_info.stop()
+
+    def expected_port_table(self):
+        dbconnector.dedicated_dbs['CONFIG_DB'] = os.path.join(mock_db_path, 'config_db', 'port_valid_speeds_expected')
+        return Db().cfgdb.get_table('PORT')
+
+    def test_port_valid_speeds_migrator(self):
+        import db_migrator
+        dbmgtr = db_migrator.DBMigrator(None)
+        dbmgtr.migrate()
+        resulting_table = dbmgtr.configDB.get_table('PORT')
+        assert not DeepDiff(resulting_table, self.expected_port_table(), ignore_order=True)
+        assert dbmgtr.get_version() == dbmgtr.CURRENT_VERSION
+
+    def test_port_valid_speeds_migrator_idempotent(self):
+        import db_migrator
+        dbmgtr = db_migrator.DBMigrator(None)
+        dbmgtr.migrate_port_valid_speeds()
+        dbmgtr.migrate_port_valid_speeds()
+        resulting_table = dbmgtr.configDB.get_table('PORT')
+        assert not DeepDiff(resulting_table, self.expected_port_table(), ignore_order=True)
