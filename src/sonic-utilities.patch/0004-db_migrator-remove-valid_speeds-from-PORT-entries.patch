From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christian Svensson <blue@cmd.nu>
Date: Mon, 9 Nov 2026 18:59:13 +0000
Subject: [PATCH] db_migrator: remove valid_speeds from PORT entries

Some platforms' port_config.ini had a valid_speeds column, which
sonic-cfggen copies into every PORT entry. sonic-port.yang has no such
leaf, so 'config reload' rejects a config_db.json that carries it.
Remove the field in common_migration_ops, which runs on every migration,
so no fork-only database version is introduced.
---
 scripts/db_migrator.py                        | 19 +++++++++++
 .../config_db/port_valid_speeds_expected.json | 25 +++++++++++++++
 .../config_db/port_valid_speeds_input.json    | 27 ++++++++++++++++
 tests/db_migrator_test.py                     | 32 +++++++++++++++++++
 4 files changed, 103 insertions(+)
 create mode 100644 tests/db_migrator_input/config_db/port_valid_speeds_expected.json
 create mode 100644 tests/db_migrator_input/config_db/port_valid_speeds_input.json

diff --git a/scripts/db_migrator.py b/scripts/db_migrator.py
index 4c376a1b..83f63120 100755
--- a/scripts/db_migrator.py
+++ b/scripts/db_migrator.py
@@ -866,6 +866,24 @@ class DBMigrator():
             self.configDB.set_entry("TACPLUS", "global", global_new)
             log.log_info('Migrate TACPLUS global: {}'.format(global_new))
 
+    def migrate_port_valid_speeds(self):
+        """
+        Remove the 'valid_speeds' field from PORT entries.
+
+        Some platforms' port_config.ini had a valid_speeds column, which
+        sonic-cfggen copies into every PORT entry. sonic-port.yang has no such
+        leaf and nothing reads the field, so a config_db.json that carries it
+        fails the YANG validation that 'config reload' runs. The stock files no
+        longer have the column; this cleans up configs made from the old ones.
+        """
+        ports = [key for key in self.configDB.get_keys('PORT')
+                 if 'valid_speeds' in self.configDB.get_entry('PORT', key)]
+        client = self.configDB.get_redis_client(self.configDB.CONFIG_DB)
+        for port in ports:
+            client.hdel('PORT{}{}'.format(self.configDB.KEY_SEPARATOR, port), 'valid_speeds')
+        if ports:
+            log.log_notice('Removed valid_speeds from {} PORT entries'.format(len(ports)))
+
     def migrate_aaa(self):
         if not self.config_src_data or 'AAA' not in self.config_src_data:
             return
@@ -1491,6 +1509,7 @@ class DBMigrator():
 
         self.migrate_tacplus()
         self.migrate_aaa()
+        self.migrate_port_valid_speeds()
 
     def migrate(self):
         version = self.get_version()
