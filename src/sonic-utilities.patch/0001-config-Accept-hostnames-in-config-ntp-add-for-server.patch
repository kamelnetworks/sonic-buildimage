From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christian Svensson <blue@cmd.nu>
Date: Thu, 5 Nov 2026 07:41:07 +0000
Subject: [PATCH] [config] Accept hostnames in 'config ntp add' for server
 associations

NTP_SERVER is keyed on inet:host in sonic-ntp.yang, which allows a
hostname for a server as well as for a pool, but the ad-hoc validation
in 'config ntp add' only accepted a hostname together with
--association-type pool and failed with 'Invalid IP address' otherwise.

Add utilities_common.cli.is_hostname(), which follows the
ietf-inet-types domain-name pattern, and accept an IP address or a
hostname for both association types. is_ipaddress() now also returns
False instead of raising for "1.2.3.4/24" style input, for which
netaddr raises a plain ValueError rather than AddrFormatError.

Carried as src/sonic-utilities.patch in kamelnetworks/sonic-buildimage
(issue #129) until it lands upstream.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012hdRF9BYypVLuPfKpQ6Cip
---
 config/main.py          |  8 +++---
 tests/config_test.py    | 57 +++++++++++++++++++++++++++++++++++++++--
 utilities_common/cli.py | 18 ++++++++++++-
 3 files changed, 77 insertions(+), 6 deletions(-)

diff --git a/config/main.py b/config/main.py
index 16440851..81141eda 100644
--- a/config/main.py
+++ b/config/main.py
@@ -9592,10 +9592,12 @@ def ntp(ctx):
 @click.option('--version', type=int, help="Specify the version for this NTP server")
 @click.pass_context
 def add_ntp_server(ctx, ntp_ip_address, association_type, iburst, version):
-    """ Add NTP server IP """
+    """ Add NTP server IP address or hostname """
     if ADHOC_VALIDATION:
-        if not clicommon.is_ipaddress(ntp_ip_address) and association_type != "pool":
-            ctx.fail('Invalid IP address')
+        # NTP_SERVER is keyed on inet:host in sonic-ntp.yang, so a hostname
+        # is valid for a server as well as for a pool.
+        if not clicommon.is_ipaddress(ntp_ip_address) and not clicommon.is_hostname(ntp_ip_address):
+            ctx.fail('Invalid IP address or hostname')
     db = ValidatedConfigDBConnector(ctx.obj['db'])
     ntp_servers = db.get_table("NTP_SERVER")
     if ntp_ip_address in ntp_servers:
