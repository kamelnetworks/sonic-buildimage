     def test_add_ntp_server_invalid_ip(self):
         config.ADHOC_VALIDATION = True
         runner = CliRunner()
         db = Db()
         obj = {'db': db.cfgdb}
 
-        result = runner.invoke(config.config.commands["ntp"], ["add", "10.10.10.x"], obj=obj)
+        result = runner.invoke(config.config.commands["ntp"], ["add", "10.10.10,4"], obj=obj)
         print(result.exit_code)
         print(result.output)
-        assert "Invalid IP address" in result.output
+        assert result.exit_code != 0
+        assert "Invalid IP address or hostname" in result.output
+        assert "NTP_SERVER" not in db.cfgdb.get_config()
+
+    @patch('utilities_common.cli.run_command')
+    def test_add_ntp_server_invalid_hostname(self, mock_run_command):
+        config.ADHOC_VALIDATION = True
+        runner = CliRunner()
+        db = Db()
+        obj = {'db': db.cfgdb}
+
+        for name in ["ntp-.example.com", "ntp..example.com", "ntp.example.com/", "ntp example.com",
+                     "a" * 64 + ".example.com", ".", "10.10.10.4/24"]:
+            result = runner.invoke(config.config.commands["ntp"], ["add", name], obj=obj)
+            print(result.exit_code)
+            print(result.output)
+            assert result.exit_code != 0, name
+            assert "Invalid IP address or hostname" in result.output, name
+        for name in ["pool-.example.com"]:
+            result = runner.invoke(config.config.commands["ntp"], ["add", "--association-type", "pool", name],
+                                   obj=obj)
+            assert result.exit_code != 0, name
+            assert "Invalid IP address or hostname" in result.output, name
+        assert "NTP_SERVER" not in db.cfgdb.get_config()
+        mock_run_command.assert_not_called()
 
     @patch('utilities_common.cli.run_command')
     def test_add_ntp_server_twice(self, mock_run_command):
diff --git a/utilities_common/cli.py b/utilities_common/cli.py
index c0538169..8f466367 100644
--- a/utilities_common/cli.py
+++ b/utilities_common/cli.py
@@ -218,11 +218,27 @@ def is_ipaddress(val):
         return False
     try:
         netaddr.IPAddress(str(val))
-    except netaddr.core.AddrFormatError:
+    except (netaddr.core.AddrFormatError, ValueError):
+        # netaddr raises a plain ValueError for "1.2.3.4/24" style input
         return False
     return True
 
 
+def is_hostname(val):
+    """ Validate if an entry is a valid hostname
+
+    Follows the ietf-inet-types domain-name pattern used by YANG inet:host
+    (the type of NTP_SERVER's key), except that the lone root "." is not
+    accepted. An IP address literal also matches this pattern, so check
+    is_ipaddress() first when the two must be told apart.
+    """
+    import re
+    if not val or len(str(val)) > 253:
+        return False
+    label = r'([a-zA-Z0-9_]([a-zA-Z0-9\-_]){0,61})?[a-zA-Z0-9]'
+    return re.fullmatch(r'(' + label + r'\.)*' + label + r'\.?', str(val)) is not None
+
+
 def is_ipprefix(val):
     """ Validate if an entry is a valid IP address prefix """
     import netaddr
