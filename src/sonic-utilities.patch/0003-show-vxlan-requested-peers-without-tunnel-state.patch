+            # A request can exist without tunnel state during startup or
+            # after a creation failure. Report that observation separately;
+            # missing STATE_DB data does not identify the cause or prove
+            # that no partial ASIC resources exist.
+            db.connect(db.APPL_DB)
+            requests = []
+            for key in natsorted(db.keys(db.APPL_DB, 'VXLAN_REMOTE_VNI_TABLE:*') or []):
+                parts = key.split(':', 2)
+                if len(parts) != 3:
+                    continue
+                _, vlan, dip = parts
+                try:
+                    if ipaddress.ip_address(dip) in state_dips:
+                        continue
+                except ValueError:
+                    continue
+                entry = db.get_all(db.APPL_DB, key)
+                if entry:
+                    requests.append([dip, vlan, entry.get('vni', 'N/A')])
+            if requests:
+                click.echo('Remote VNI requests without tunnel state:')
+                click.echo(tabulate(requests, ['DIP', 'VLAN', 'VNI'], tablefmt='grid'))
